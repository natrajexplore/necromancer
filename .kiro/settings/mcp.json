{
  "mcpServers": {
    "necromancer": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "backend",
        "python",
        "mcp_server.py"
      ],
      "disabled": false,
      "autoApprove": [
        "exhume",
        "autopsy",
        "gate"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false
    }
  }
}
